# ─────────────────────────────────────────────────────────────────────────────
# Lumière Café Backend — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit the .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED: Must be >= 64 ASCII characters for HS512.
# Generate with: openssl rand -base64 64
JWT_SECRET=lumiere-cafe-super-secret-key-must-be-at-least-64-characters-long-for-hs512!!

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Each service connects to its own database within the same cluster.
# Local single-instance (docker-compose default):
MONGODB_URI_USERS=mongodb://localhost:27017/lumiere_users
MONGODB_URI_MENU=mongodb://localhost:27017/lumiere_menu
MONGODB_URI_ORDERS=mongodb://localhost:27017/lumiere_orders
MONGODB_URI_CAFE=mongodb://localhost:27017/lumiere_cafe

# Atlas (production):
# MONGODB_URI_USERS=mongodb+srv://user:pass@cluster.mongodb.net/lumiere_users?retryWrites=true

# ── Ports ─────────────────────────────────────────────────────────────────────
EUREKA_PORT=8761
GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
MENU_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
CAFE_SERVICE_PORT=8084

# ── Eureka ────────────────────────────────────────────────────────────────────
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000

# ── Frontend API URL ──────────────────────────────────────────────────────────
# Used by the React app (.env file in frontend/)
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_SITE_NAME=Lumière Café
REACT_APP_SITE_URL=http://localhost:3000

# ── Email (Phase 2 — forgot password) ────────────────────────────────────────
# Set to 'simulated' to log tokens to console instead of sending real email.
EMAIL_MODE=simulated
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
